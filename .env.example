# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Required. Runtime SQLite file under var/. Relative sqlite paths are
# resolved from the repo root. Tests must not use this path.
DATABASE_URL=sqlite:///var/neodermo.sqlite

# Exact frontend Origin allowed for unsafe API requests. Comma-separate
# additional trusted origins; do not use wildcards.
TRUSTED_FRONTEND_ORIGINS=http://127.0.0.1:5000

# Absolute database session lifetime in seconds (default: 12 hours).
SESSION_LIFETIME_SECONDS=43200

# Local loopback HTTP only. Omit or set 0 when serving HTTPS.
ALLOW_INSECURE_LOOPBACK_COOKIE=1

# Optional. 1 enables the local reloader.
FLASK_DEBUG=1
