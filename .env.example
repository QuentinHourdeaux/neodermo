# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Required. Use a long random string locally.
SECRET_KEY=replace-with-a-local-secret

# Required. Runtime SQLite file under var/. Tests must not use this path.
DATABASE_URL=sqlite:///var/neodermo.sqlite

# Optional. 1 enables the local reloader.
FLASK_DEBUG=1
